{
    "name": "planeasoluciones/wp-citas",
    "description": "WordPress plugin for managing and displaying quotes with authors, themes and categories",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6,<4.0",
        "wp-coding-standards/wpcs": "^3.4.1,<4.0",
        "phpcsstandards/phpcsutils": "^1.2.3,<2.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1,<2.0",
        "phpstan/phpstan": "^2.3.7,<3.0",
        "szepeviktor/phpstan-wordpress": "^2.0.4,<3.0",
        "phpstan/extension-installer": "^1.4.3,<2.0"
    },
    "scripts": {
        "lint": "phpcs -n",
        "fix": "phpcbf",
        "post-install-cmd": "git config core.hooksPath .githooks || true",
        "post-update-cmd": "git config core.hooksPath .githooks || true"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": ">=8.2,<8.6",
        "yahnis-elsts/plugin-update-checker": "^6.0,<7.0"
    }
}
